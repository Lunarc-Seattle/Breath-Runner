{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4180/?page=home#/home",
        "http://127.0.0.1:4180/?page=play#/play",
        "http://127.0.0.1:4180/?page=history#/history"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85
          }
        ]
      },
      "aggregationMethod": "pessimistic"
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-report"
    }
  }
}
