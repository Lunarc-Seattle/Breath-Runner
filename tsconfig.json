// Type checking only (`npm run typecheck`); nothing is emitted. Vite strips types for the browser,
// Node 24 strips them natively for the server and tests.
//
// Two TypeScript packages are installed on purpose:
// - `typescript-7` (npm alias of typescript@7, the native Go compiler) runs `npm run typecheck`.
//   Its `typescript` entry point only exports the version, so it cannot serve tools that use the JS API.
// - `typescript` (5.9) provides that JS API for typescript-eslint (peer range `<6.1.0`) and the editor.
// Use `npm run typecheck`, not `npx tsc`: both packages ship a `tsc` binary.
// Drop `typescript` 5.9 once typescript-eslint supports TypeScript 7.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "server", "tests", "vite.config.js"]
}
