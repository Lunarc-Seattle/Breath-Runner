{
  "name": "breath-runner",
  "version": "2.5.0",
  "private": true,
  "description": "Breath Runner: a gamified breathing-training web app for post-surgery lung recovery, by Jie (Fia) Yin",
  "type": "module",
  "author": "Jie (Fia) Yin",
  "license": "UNLICENSED",
  "keywords": [
    "react",
    "vite",
    "tailwindcss",
    "typescript",
    "pwa",
    "canvas",
    "web-bluetooth",
    "game",
    "breathing",
    "healthcare",
    "rehabilitation",
    "spirometry",
    "gamification",
    "playwright",
    "lighthouse"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "start": "npm run build && npm run server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/core/**' --test-coverage-include='src/lib/**' --test-coverage-include='server/**' --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=85 tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "test:ci": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='src/core/**' --test-coverage-include='src/lib/**' --test-coverage-include='server/**' --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=85 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=junit --test-reporter-destination=coverage/junit.xml tests/*.test.js",
    "quality-report": "node scripts/ci/quality-report.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "better-sqlite3": "^13.0.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "10.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=24"
  }
}
