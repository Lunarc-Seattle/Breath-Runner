{
  "name": "aerocare-trace-sim-infra-platform",
  "version": "3.2.0",
  "description": "Full-Stack Pulmonary & Bio-Thermal Trace-Driven Simulation Infrastructure, Regression Pipeline & Editorial Web Suite (React 18 + Node.js/Express + C++/Python Tooling)",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "node server/server.js",
    "regression": "python3 scripts/automation/run_regression.py",
    "start": "concurrently \"npm run server\" \"npm run dev\""
  },
  "keywords": [
    "simulation-infrastructure",
    "trace-driven-simulation",
    "thermal-power-solver",
    "cfd-reduced-order-model",
    "regression-automation",
    "react-18",
    "express-rest-api"
  ],
  "author": "Jiafeng Du",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "express": "^4.19.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  }
}
